{
  "name": "strength",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute strength --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute strength --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute strength --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute strength --remote --file=./seed.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "wrangler": "^4.105.0"
  }
}
